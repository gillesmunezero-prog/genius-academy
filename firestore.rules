rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
function signedIn() { return request.auth != null; }
function isAdmin() { return signedIn() && request.auth.token.admin == true; }
function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
function myFamilyId() { return myUser().familyId; }
function myRole() { return myUser().role; }
function myChildId() { return myUser().childId; }

match /users/{uid} {
  allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
  allow write: if false;
}

match /families/{famId} {
  allow read: if isAdmin() || (signedIn() && myFamilyId() == famId);
  allow write: if false;

  match /members/{memberUid} {
    allow read: if isAdmin() || (signedIn() && myFamilyId() == famId);
    allow write: if false;
  }

  match /children/{childId} {
    allow read: if isAdmin() || (signedIn() && myFamilyId() == famId && (myRole() == 'parent' || myChildId() == childId));
    allow write: if false;

    match /{sub}/{docId} {
      allow read: if isAdmin() || (signedIn() && myFamilyId() == famId && (myRole() == 'parent' || myChildId() == childId));
      allow create, update: if signedIn() && myFamilyId() == famId && (myRole() == 'parent' || myChildId() == childId);
      allow delete: if isAdmin();
    }
  }
}

match /adminAuditLog/{logId} {
  allow read, write: if isAdmin();
}
  }
}
